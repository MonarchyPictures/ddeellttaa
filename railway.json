{
  "$schema": "https://railway.app/railway.schema.json",
  "environments": {
    "production": {
      "name": "production",
      "variables": {
        "HIGH_RECALL_MODE": "true",
        "SCRAPER_CONCURRENCY": "3",
        "CACHE_TTL_SECONDS": "600",
        "SCRAPER_TIMEOUT_SECONDS": "25",
        "TOTAL_PHASE_TIMEOUT_SECONDS": "60",
        "PYTHONPATH": "/app",
        "PORT": "8000"
      },
      "services": {
        "redis": {
          "type": "redis",
          "name": "delta9-redis"
        },
        "postgres": {
          "type": "database",
          "name": "delta9-postgres"
        },
        "api": {
          "name": "delta9-api",
          "build": {
            "builder": "NIXPACKS"
          },
          "deploy": {
            "startCommand": "python -m app.main",
            "healthcheckPath": "/health",
            "healthcheckTimeout": 30,
            "restartPolicyType": "ON_FAILURE",
            "restartPolicyMaxRetries": 3
          },
          "dependsOn": ["redis", "postgres"]
        },
        "worker": {
          "name": "delta9-worker",
          "build": {
            "builder": "NIXPACKS"
          },
          "deploy": {
            "startCommand": "celery -A app.core.celery_app.celery worker --loglevel=info",
            "restartPolicyType": "ON_FAILURE",
            "restartPolicyMaxRetries": 3
          },
          "dependsOn": ["redis", "postgres"]
        },
        "beat": {
          "name": "delta9-beat",
          "build": {
            "builder": "NIXPACKS"
          },
          "deploy": {
            "startCommand": "celery -A app.core.celery_app.celery beat --loglevel=info",
            "restartPolicyType": "ON_FAILURE",
            "restartPolicyMaxRetries": 3
          },
          "dependsOn": ["redis", "postgres"]
        }
      }
    }
  }
}
